# Sao chép thành .env.local và điền giá trị. Khai báo giống hệt trong Vercel → Settings → Environment Variables.
# Chỉ đặt giá trị CÔNG KHAI ở đây (tiền tố VITE_ sẽ lộ ra trình duyệt).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_VAPID_PUBLIC_KEY=

# KHÔNG đặt ở đây: service_role key, TELEGRAM_BOT_TOKEN, VAPID_PRIVATE_KEY…
# Những giá trị đó chỉ lưu bằng: supabase secrets set TÊN=giá_trị
